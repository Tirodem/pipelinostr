id: morse-received
name: Morse Code Received
enabled: false
trigger:
  source: nostr.dm
  content_pattern: ^morse-received:\s*(?<content>.+)$
actions:
  - id: telegram
    type: telegram
    action: message
    chat_id: ${TELEGRAM_CHAT_ID}
    text: |
      Morse code received:

      {{ match.content }}
  - id: nostr_dm
    type: nostr_dm
    to: ${MY_NPUB}
    content: |
      Morse code decoded: {{ match.content }}
