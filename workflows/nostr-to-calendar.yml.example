id: calendar-invite
name: Send Calendar Invite via DM
enabled: true
trigger:
  source: nostr.dm
  from_whitelist: true
  content_pattern: ^[Ii]nvite\s+(?<to>[^:]+):\s*(?<title>[^@]+)@\s*(?<start>\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2})\s*\((?<duration>[^)]+)\)(?:\s*@\s*(?<location>.+))?$
actions:
  - id: send_invite
    type: calendar
    to: "{{ trim match.to }}"
    title: "{{ trim match.title }}"
    start: "{{ trim match.start }}"
    duration: "{{ trim match.duration }}"
    location: "{{ trim match.location }}"
