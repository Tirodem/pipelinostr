# PipeliNostr v2 — DPO Report command
# Responds to /dpo command with a GDPR compliance report.

id: dpo-command
name: DPO Report Command
description: Generate GDPR data processing report

trigger:
  source: nostr.dm
  from_whitelist: true
  content_pattern: "^/dpo$"

actions:
  - id: generate_report
    type: dpo_report
    format: markdown

  - id: send_report
    type: nostr_dm
    when: "actions.generate_report.success"
    to: "{{ trigger.sender }}"
    dm_format: "{{ trigger.dm_format }}"
    content: "{{ actions.generate_report.response.report }}"

  - id: notify_failure
    type: nostr_dm
    when: "!actions.generate_report.success"
    to: "{{ trigger.sender }}"
    dm_format: "{{ trigger.dm_format }}"
    content: |
      Error generating DPO report:
      {{ actions.generate_report.error }}
