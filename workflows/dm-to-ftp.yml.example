id: dm-to-ftp
name: Append DM to FTP Log
enabled: true
trigger:
  source: nostr.dm
  from_whitelist: true
  content_pattern: ^[Ff][Tt][Pp]:\s*(?<message>.+)
actions:
  - id: append_to_ftp
    type: ftp
    operation: append
    remote_path: /logs/nostr-dm-{date}.log
    content: |
      [{{ trigger.timestamp }}] {{ trigger.from }}: {{ match.message }}
    create_dirs: true
