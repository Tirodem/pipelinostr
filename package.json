{
  "name": "pipelinostr",
  "version": "0.1.0",
  "description": "Nostr Event Router - Le n8n de Nostr",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:clean": "npm run clean && npm run build",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/index.js",
    "start:dev": "tsx watch src/index.ts",
    "dev": "npm run start:dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "nostr",
    "router",
    "event",
    "bridge",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.7",
    "handlebars": "^4.7.8",
    "nodemailer": "^6.9.16",
    "nostr-tools": "^2.10.4",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.2",
    "ws": "^8.18.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
