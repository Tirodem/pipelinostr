# Workflow: Zap to USB Dispenser Error
# Notifie l'utilisateur si le distributeur échoue

id: zap-to-usb-dispenser-error
name: Zap USB Dispenser Error
enabled: true
description: Notification d'erreur pour le distributeur USB

trigger:
  type: hook

actions:
  - id: notify_error
    type: nostr_dm
    params:
      recipient: "{{ trigger.sender_npub }}"
      message: |
        Erreur lors de la distribution !

        Zap: {{ trigger.amount_sats }} sats
        Erreur: {{ parent.error }}

        Veuillez contacter l'administrateur.
