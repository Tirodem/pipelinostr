# PipeliNostr Status Command
#
# Usage: /pipelinostr status
# Shows system status, workflows, handlers, resources

id: pipelinostr-status
name: PipeliNostr Status Command
enabled: true

trigger:
  type: dm
  from_whitelist: true
  filters:
    content_pattern: "^/pipelinostr\\s+status$"

actions:
  - id: get_status
    type: system
    action: status

  - id: reply
    type: nostr_dm
    recipient: "{{ trigger.pubkey_npub }}"
    message: "{{ actions.get_status.response.formatted }}"
