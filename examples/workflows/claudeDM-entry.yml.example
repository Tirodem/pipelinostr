# ClaudeDM Entry Point - Paid Claude API via Nostr DM
#
# This workflow is the entry point for the ClaudeDM service.
# Users can interact with Claude API by paying with SATs zaps.
#
# Usage: Send a DM with "/claudeDM <your question>"
#
# Flow:
# 1. Check if user has sufficient balance (configurable threshold)
# 2. Send request to Claude API
# 3. Calculate cost based on tokens used
# 4. Debit user's balance
# 5. Reply with Claude's response + cost info
#
# Prerequisites:
# - zap-balance-tracker workflow running
# - workflow_db handler (system)
# - claude handler configured with API key
# - nostr handler for DM replies
#
# Configuration:
# - min_balance_sats: Minimum SATs required (default: 40)
# - max_tokens: Maximum tokens for Claude response (default: 1000)
# - sats_per_1k_tokens: Cost in SATs per 1000 tokens (default: 10)
#
# Error handling:
# - Insufficient balance -> claudeDM-insufficient-balance
# - Claude API error -> claudeDM-error-response

id: claudeDM-entry
name: ClaudeDM Entry Point
enabled: false

trigger:
  type: dm
  # Limit message length via regex - max ~4000 chars
  content_match: "^/claudeDM\\s+(.{1,4000})$"
  # Optional: whitelist specific users
  # from_whitelist:
  #   - "npub1..."

# Configuration variables
variables:
  min_balance_sats: 40
  max_tokens: 1000
  sats_per_1k_tokens: 10

actions:
  # Step 1: Check user's balance
  - id: check_balance
    type: workflow_db
    config:
      action: check
      workflow_id: zap-balance-tracker
      namespace: balances
      key: "balance:{{ trigger.author_npub }}"
      operator: gte
      compare_value: "{{ variables.min_balance_sats }}"
    on_fail:
      workflow: claudeDM-insufficient-balance
      pass_context: true

  # Step 2: Get current balance for reference
  - id: get_current_balance
    type: workflow_db
    config:
      action: get
      workflow_id: zap-balance-tracker
      namespace: balances
      key: "balance:{{ trigger.author_npub }}"

  # Step 3: Send request to Claude
  - id: claude_request
    type: claude
    config:
      action: chat
      message: "{{ match.1 }}"
      max_tokens: "{{ variables.max_tokens }}"
    on_fail:
      workflow: claudeDM-error-response
      pass_context: true

  # Step 4: Debit user's balance based on tokens used
  # Cost = ceil(tokens_used * sats_per_1k_tokens / 1000), minimum 1 SAT
  - id: debit_balance
    type: workflow_db
    config:
      action: decrement
      workflow_id: zap-balance-tracker
      namespace: balances
      key: "balance:{{ trigger.author_npub }}"
      amount: "{{ sats_cost actions.claude_request.data.tokens_used variables.sats_per_1k_tokens }}"
      min_value: 0
      track_history: true

  # Step 5: Get new balance after debit
  - id: get_new_balance
    type: workflow_db
    config:
      action: get
      workflow_id: zap-balance-tracker
      namespace: balances
      key: "balance:{{ trigger.author_npub }}"

  # Step 6: Reply to user with response and cost info
  - id: reply
    type: nostr_dm
    config:
      recipient: "{{ trigger.author_npub }}"
      content: |
        {{ actions.claude_request.data.response }}

        ---
        Tokens: {{ actions.claude_request.data.tokens_used }} (in: {{ actions.claude_request.data.input_tokens }}, out: {{ actions.claude_request.data.output_tokens }})
        Cout: {{ sats_cost actions.claude_request.data.tokens_used variables.sats_per_1k_tokens }} SATs
        Solde: {{ actions.get_new_balance.data.value | default: 0 }} SATs
