# Claude Handler Status Command
#
# Reply with Claude handler status when receiving /claude status via DM.
# Provides: configuration, model, pending workflows, allowed handlers.
#
# Requirements:
# - Whitelist must be enabled (only authorized users can request status)
# - Claude handler must be configured with API key
#
# Usage: Send a DM with "/claude status" to your PipeliNostr npub

id: claude-status
name: Claude Handler Status Command
enabled: true

trigger:
  type: nostr_event
  filters:
    kinds: [4, 1059]
    # Match /claude status (case insensitive)
    content_pattern: "(?i)^/claude\\s+status$"
    from_whitelist: true

actions:
  # Get Claude handler status
  - id: get_status
    type: claude
    config:
      action: status

  # Reply with formatted status
  - id: reply
    type: nostr_dm
    config:
      to: "{{ trigger.pubkey }}"
      content: "{{ actions.get_status.response.formatted }}"
