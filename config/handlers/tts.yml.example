# Configuration TTS (Text-to-Speech) Handler
tts:
  enabled: true

  # Moteur TTS: "piper" (recommande) ou "espeak"
  # Piper: haute qualite, voix naturelle
  # espeak: leger, voix robotique
  engine: piper

  # === Configuration Piper ===
  # Chemin vers l'executable piper (defaut: "piper" dans le PATH)
  # piper_path: /usr/local/bin/piper

  # Modele vocal par defaut
  # Liste complete: https://rhasspy.github.io/piper-samples/
  piper_model: fr_FR-siwis-medium

  # === Configuration espeak ===
  # Voix espeak par defaut (fr, en, de, es, etc.)
  # espeak_voice: fr

  # === General ===
  # Repertoire de sortie pour les fichiers audio
  output_dir: ./data/tts

# Installation Piper sur Raspberry Pi:
# 1. pip install piper-tts
# 2. Premier lancement telecharge le modele automatiquement
#    ou: piper --download-model fr_FR-siwis-medium
#
# Installation ffmpeg (pour conversion OGG):
# sudo apt install ffmpeg
#
# Modeles vocaux disponibles:
# - fr_FR-siwis-medium : Francais feminin (naturel)
# - fr_FR-upmc-medium : Francais masculin
# - en_US-lessac-medium : Anglais US feminin
# - en_GB-alba-medium : Anglais UK feminin
# - de_DE-thorsten-medium : Allemand masculin
# - es_ES-davefx-medium : Espagnol masculin
